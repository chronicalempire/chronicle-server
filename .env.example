# Chronicle Empire Server — Environment Variables
# НИКОГДА не коммить в git!

# ── Основной минт (thirdweb + ethers) ──────────────────────────────
# Приватный ключ кошелька ВЛАДЕЛЬЦА контракта (без 0x)
# Именно тот кошелёк который деплоил контракт в thirdweb
OWNER_PRIVATE_KEY=your_owner_private_key_here

# Alchemy (или другой) RPC URL, Polygon Mainnet
POLYGON_RPC=https://polygon-mainnet.g.alchemy.com/v2/your_key

# thirdweb Secret Key (Dashboard → Settings → API Keys)
THIRDWEB_SECRET_KEY=your_thirdweb_secret_key_here

# URL твоей игры на Netlify (для CORS), через запятую если несколько
GAME_URL=https://your-game.netlify.app

# Port (Render подставит автоматически)
PORT=3000

# ── Wert NFT Checkout (оплата картой) ──────────────────────────────
# ВНИМАНИЕ: это ключ ПОДПИСИ ЗАПРОСА к Wert API, а не блокчейн-ключ.
# Для sandbox его выдаёт сам Wert (Partner Dashboard → NFT Checkout).
WERT_PRIVATE_KEY=your_wert_sandbox_signing_key_here

# Partner ID из Wert Partner Dashboard (не секрет, но держим тут для удобства)
WERT_PARTNER_ID=your_wert_partner_id_here

# Адрес твоего контракта В ТОЙ ЖЕ СЕТИ, что указана в WERT_NETWORK
# (для sandbox — тестовая копия на Amoy, НЕ mainnet-адрес)
WERT_SC_ADDRESS=your_amoy_or_polygon_contract_address

# sandbox: amoy · прод: polygon
WERT_NETWORK=amoy

# sandbox: https://sandbox.wert.io · прод: https://widget.wert.io
WERT_ORIGIN=https://sandbox.wert.io

# Валюта оплаты (см. Supported coins and blockchains в доках Wert)
WERT_COMMODITY=POL

# Опционально: свой RPC для сети Wert, если не хочешь публичный Amoy RPC
# WERT_RPC_URL=https://rpc-amoy.polygon.technology

# Куда падают донаты (по умолчанию — тот же кошелёк, что подписывает /mint-boss)
# DONATION_ADDRESS=0xYourProjectWalletAddress
